# Database Configuration
# Default PostgreSQL container url:
DATABASE_URL=postgresql://repo_analyzer:CHANGE_ME@localhost:5432/repo_analyzer
# Fallback to SQLite if PostgreSQL is not available:
# DATABASE_URL=sqlite:///./repo_analyzer.db

# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration
# Options: 'local' (sentence-transformers), 'gemini' (google-generativeai), 'openai'
EMBEDDING_PROVIDER=local

# Optional API Keys for embeddings if not using 'local'
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Port
PORT=8000
HOST=0.0.0.0

# Security and resource limits
ENVIRONMENT=production
CORS_ORIGINS=https://repo-analyzer-eight.vercel.app
REPO_SCAN_ROOT=/home/ubuntu
ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
MAX_ANALYZED_FILE_BYTES=2000000
MAX_FILES_PER_REPOSITORY=10000
MAX_SOURCE_RESPONSE_BYTES=1000000
MAX_EXACT_FILE_BYTES=3000
MAX_EXACT_CONTEXT_BYTES=10000
SESSION_REPO_TTL_HOURS=24

# Groq model; use a currently supported production model
GROQ_MODEL=openai/gpt-oss-20b

# Incremental indexing and performance
# Set true for correctness-first hashing on every scan; false reuses matching size/mtime metadata.
STRICT_HASHING=false
CRAWL_PROGRESS_INTERVAL_SECONDS=0.5
STATIC_ANALYSIS_BATCH_SIZE=100
DEPENDENCY_BATCH_SIZE=1000
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MODEL_BATCH_SIZE=32
